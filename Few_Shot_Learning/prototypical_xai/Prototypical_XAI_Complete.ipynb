   "source": [
    "# ============================================================\n",
    "# PROTOTYPICAL NETWORK MODEL\n",
    "# ============================================================\n",
    "\n",
    "class ConvEncoder(nn.Module):\n",
    "    \"\"\"\n",
    "    Convolutional encoder for embedding images into vector space.\n",
    "    \n",
    "    Architecture: 4 convolutional blocks with batch normalization,\n",
    "    ReLU activation, and max pooling, followed by a fully connected\n",
    "    layer to produce fixed-dimensional embeddings.\n",
    "    \n",
    "    Forward pass:\n",
    "    x → ConvBlock1 → ConvBlock2 → ConvBlock3 → AdaptivePool → FC → z\n",
    "    \n",
    "    Args:\n",
    "        out_dim: Dimension of output embedding (default: 128)\n",
    "    \n",
    "    Returns:\n",
    "        z: Embedding vector of shape [batch_size, out_dim]\n",
    "    \"\"\"\n",
    "    def __init__(self, out_dim=128):\n",
    "        super().__init__()\n",
    "        \n",
    "        # Convolutional blocks\n",
    "        self.encoder = nn.Sequential(\n",
    "            # Block 1: 3 -> 32 channels\n",
    "            nn.Conv2d(3, 32, kernel_size=3, padding=1),\n",
    "            nn.BatchNorm2d(32),\n",
    "            nn.ReLU(inplace=True),\n",
    "            nn.MaxPool2d(2),  # 128 -> 64\n",
    "            \n",
    "            # Block 2: 32 -> 64 channels\n",
    "            nn.Conv2d(32, 64, kernel_size=3, padding=1),\n",
    "            nn.BatchNorm2d(64),\n",
    "            nn.ReLU(inplace=True),\n",
    "            nn.MaxPool2d(2),  # 64 -> 32\n",
    "            \n",
    "            # Block 3: 64 -> 128 channels\n",
    "            nn.Conv2d(64, 128, kernel_size=3, padding=1),\n",
    "            nn.BatchNorm2d(128),\n",
    "            nn.ReLU(inplace=True),\n",
    "            nn.MaxPool2d(2),  # 32 -> 16\n",
    "            \n",
    "            # Block 4: Final conv layer\n",
    "            nn.Conv2d(128, 128, kernel_size=3, padding=1),\n",
    "            nn.BatchNorm2d(128),\n",
    "            nn.ReLU(inplace=True),\n",
    "            nn.MaxPool2d(2),  # 16 -> 8\n",
    "            \n",
    "            # Adaptive pooling to fixed size\n",
    "            nn.AdaptiveAvgPool2d((2, 2))  # Force to 2x2\n",
    "        )\n",
    "        \n",
    "        # Projection head\n",
    "        self.fc = nn.Sequential(\n",
    "            nn.Flatten(),\n",
    "            nn.Linear(128 * 2 * 2, 256),\n",
    "            nn.ReLU(inplace=True),\n",
    "            nn.Dropout(0.3),\n",
    "            nn.Linear(256, out_dim)\n",
    "        )\n",
    "    \n",
    "    def forward(self, x):\n",
    "        x = self.encoder(x)     # [B, 128, 2, 2]\n",
    "        x = self.fc(x)          # [B, out_dim]\n",
    "        return x\n",
    "\n",
    "\n",
    "class ProtoNet(nn.Module):\n",
    "    \"\"\"\n",
    "    Prototypical Network for few-shot classification.\n",
    "    \n",
    "    Components:\n",
    "    1. Embedding network: Maps images to embedding space\n",
    "    2. Prototype computation: Averages support embeddings per class\n",
    "    3. Distance-based classification: Computes distances to prototypes\n",
    "    \n",
    "    Forward pass:\n",
    "    1. z_support = f_phi(support) - embed support images\n",
    "    2. z_query = f_phi(query) - embed query images\n",
    "    3. p_c = mean(z_support for class c) - compute prototypes\n",
    "    4. d(x, p_c) = ||z_query - p_c||² - compute distances\n",
    "    5. logits = -d(x, p_c) - convert to logits\n",
    "    \n",
    "    Args:\n",
    "        embedding_net: CNN encoder for computing embeddings\n",
    "    \"\"\"\n",
    "    def __init__(self, embedding_net):\n",
    "        super().__init__()\n",
    "        self.embedding_net = embedding_net\n",
    "\n",
    "    def forward(self, support, support_labels, query):\n",
    "        \"\"\"\n",
    "        Forward pass through prototypical network.\n",
    "        \n",
    "        Args:\n",
    "            support: Support images [N*K, C, H, W]\n",
    "            support_labels: Support labels [N*K]\n",
    "            query: Query images [N*Q, C, H, W]\n",
    "        \n",
    "        Returns:\n",
    "            logits: Classification logits [N*Q, N]\n",
    "            prototypes: Class prototypes [N, D]\n",
    "            z_query: Query embeddings [N*Q, D]\n",
    "        \"\"\"\n",
    "        # Encode support and query images\n",
    "        z_support = self.embedding_net(support)   # [N*K, D]\n",
    "        z_query = self.embedding_net(query)      # [N*Q, D]\n",
    "        \n",
    "        # Compute prototypes per class\n",
    "        unique_labels = torch.unique(support_labels)\n",
    "        prototypes = []\n",
    "        for c in unique_labels:\n",
    "            # p_c = (1/|S_c|) * sum_{x in S_c} f(x)\n",
    "            class_embeddings = z_support[support_labels == c]\n",
    "            prototypes.append(class_embeddings.mean(dim=0))\n",
    "        prototypes = torch.stack(prototypes)  # [N, D]\n",
    "        \n",
    "        # Compute squared Euclidean distances to prototypes\n",
    "        dists = euclidean_dist(z_query, prototypes)  # [N*Q, N]\n",
    "        \n",
    "        # Convert distances to logits: higher probability for closer prototypes\n",
    "        logits = -dists\n",
    "        \n",
    "        return logits, prototypes, z_query\n",
    "\n",
    "\n",
    "def euclidean_dist(x, y):\n",
    "    \"\"\"\n",
    "    Compute squared Euclidean distance between two sets of vectors.\n",
    "    \n",
    "    Mathematical formula:\n",
    "    d(x_i, y_j) = ||x_i - y_j||² = ||x_i||² + ||y_j||² - 2 * x_i · y_j\n",
    "    \n",
    "    This is more efficient than computing pairwise distances naively.\n",
    "    \n",
    "    Args:\n",
    "        x: [n, d] first set of vectors\n",
    "        y: [m, d] second set of vectors\n",
    "    \n",
    "    Returns:\n",
    "        dist: [n, m] pairwise squared distances\n",
    "    \"\"\"\n",
    "    n = x.size(0)\n",
    "    m = y.size(0)\n",
    "    d = x.size(1)\n",
    "    \n",
    "    assert d == y.size(1), f\"Dimension mismatch: {d} vs {y.size(1)}\"\n",
    "    \n",
    "    # ||x_i||² term: [n, 1]\n",
    "    xx = (x ** 2).sum(dim=1, keepdim=True).expand(n, m)\n",
    "    # ||y_j||² term: [1, m]\n",
    "    yy = (y ** 2).sum(dim=1, keepdim=True).expand(m, n).t()\n",
    "    # -2 * x_i · y_j term\n",
    "    dist = xx + yy - 2.0 * x @ y.t()\n",
    "    \n",
    "    # Numerical stability: clip negative values due to rounding\n",
    "    dist = torch.clamp(dist, min=0.0)\n",
    "    \n",
    "    return dist\n",
    "\n",
    "\n",
    "def proto_loss(logits, query_labels):\n",
    "    \"\"\"\n",
    "    Compute prototypical loss (negative log-likelihood).\n",
    "    \n",
    "    Mathematical formula:\n",
    "    L = -log P(y=c|x) = -log [exp(-d(x,p_c)) / sum_c' exp(-d(x,p_c'))]\n",
    "    \n",
    "    This is equivalent to cross-entropy loss on the distance-based logits.\n",
    "    \n",
    "    Args:\n",
    "        logits: [N*Q, N] classification logits\n",
    "        query_labels: [N*Q] ground truth labels (0 to N-1)\n",
    "    \n",
    "    Returns:\n",
    "        loss: Scalar loss value\n",
    "    \"\"\"\n",
    "    return F.cross_entropy(logits, query_labels)"
   ]
